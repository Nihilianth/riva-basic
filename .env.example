# Set credentials locally. Never commit .env or paste keys into agent conversations.
OPENAI_API_KEY=
# Audio experiments must resolve private storage outside the Git checkout.
# Export this variable in your shell; this project does not auto-load .env.
RIVA_PRIVATE_DIR=../private
# Optional voice-baseline overrides; defaults work without adding these to .env.
RIVA_LLM_MODEL=gpt-4.1-mini
RIVA_TTS_MODEL=gpt-4o-mini-tts
RIVA_TTS_VOICE=coral
